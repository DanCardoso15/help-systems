<%- include('partials/header') %>

<div class="w-full h-screen flex flex-col justify-center items-center gap-5">
    <h1 class="font-display text-3xl">Solicitações para Responder</h1>
    <div class="w-3/5 flex flex-col justify-center bg-slate-100">
    
        <% if (solicitacoes.length === 0) { %>
            <p class="bg-red-100 pl-1 rounded border-solid border-l-4 border-red-500 font-semibold text-lg mb-3">Nenhuma solicitação encontrada.</p>
        <% } else { %>

            <table border="1" cellpadding="8" cellspacing="0" class="px-5 py-3 bg-slate-200 rounded mt-5">
                <thead class="text-lg rounded text-center font-semibold font-display">
                    <tr class="bg-slate-300 border-solid border-b-4 border-purple-800">
                        <th>Título</th>
                        <th>Pergunta</th>
                        <th>Colaborador</th>
                        <th>Departamento</th>
                        <th>Ação</th>
                    </tr>
                </thead>
                <tbody>
                    <% solicitacoes.forEach(s => { %>
                        <tr>
                            <td class="font-semibold"><%= s.titulo_pergunta %></td>
                            <td  class="text-slate-700"></td>><%= s.pergunta %></td>
                            <td><%= s.nome %></td>
                            <td class="text-center"><%= s.departamento %></td>
                            <td class="text-center"><a href="/respostas/<%= s.IDsolicitacao %>" class="bg-emerald-500 text-white px-3 py-1 rounded">Responder</a></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
        <a href="/home"><button class="self-center px-10 py-4 bg-slate-700 text-white rounded">Voltar</button></a>
    </div>
</div>


    <%- include('partials/footer') %>
