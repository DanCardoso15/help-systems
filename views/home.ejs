<%- include('partials/header') %>

<div class="w-full h-screen flex flex-col justify-center align-center">
    <div>
        <h1>Dashboard</h1>
        
        <!-- RF02.3: Nome e departamento do usuario -->
        <div>
            <p><strong>Usuario:</strong> <%= usuario.nome %></p>
            <p><strong>Departamento:</strong> <%= usuario.departamento %></p>
        </div>
        
        <!-- RF02.2: Botoes de acesso -->
        <div class="w-full flex gap-4 text-lg flex-row-reverse">
            <a href="/ver-respostas" class="px-4 py-2 bg-amber-400 text-white font-bold font-display rounded mt-5"><button>Ver Respostas</button></a>
            <a href="/respostas"><button class="px-6 py-2 bg-emerald-600 text-white font-bold font-display rounded mt-5">Quero responder</button></a>
            <a href="/solicitacoes/nova"><button class="px-6 py-2 bg-sky-500 text-white font-bold font-display rounded mt-5">Tenho Dúvida</button></a>
        </div>
        
        <!-- RF05.2: Filtros -->
        <h3 class="font-display text-2xl">Solicitações</h3>
        
        <div class="flex flex-col gap-8">
            <form method="GET" action="/home" class="flex gap-4">
                <div class="flex gap-3">
                    <label for="titulo">Titulo</label>
                    <input type="text" id="titulo" name="titulo" value="<%= filtros.titulo %>" placeholder="Buscar por titulo" class="px-1 bg-slate-50 rounded border">
                </div>
                <div class="flex gap-3">
                    <label for="colaborador">Nome</label>
                    <input type="text" id="colaborador" name="colaborador" value="<%= filtros.colaborador %>" placeholder="Buscar por colaborador" class="px-1 bg-slate-50 rounded border">
                </div>
                <div class="flex gap-3">
                    <label for="departamento">Departamento</label>
                    <select id="departamento" name="departamento" class="px-2 bg-slate-200 border-2 border-solid border-slate-300 rounded">
                        <option value="">Todos</option>
                        <option value="TI" <%= filtros.departamento === 'TI' ? 'selected' : '' %>>TI</option>
                        <option value="RH" <%= filtros.departamento === 'RH' ? 'selected' : '' %>>RH</option>
                        <option value="Financeiro" <%= filtros.departamento === 'Financeiro' ? 'selected' : '' %>>Financeiro</option>
                        <option value="Comercial" <%= filtros.departamento === 'Comercial' ? 'selected' : '' %>>Comercial</option>
                        <option value="Marketing" <%= filtros.departamento === 'Marketing' ? 'selected' : '' %>>Marketing</option>
                        <option value="Operacoes" <%= filtros.departamento === 'Operacoes' ? 'selected' : '' %>>Operacoes</option>
                        <option value="Juridico" <%= filtros.departamento === 'Juridico' ? 'selected' : '' %>>Juridico</option>
                    </select>
                </div>
                <div class="flex gap-3">
                    <label for="categoria">Destino</label>
                    <select id="categoria" name="categoria" class="px-2 py-1 bg-slate-200 border-2 border-solid border-slate-300 rounded">
                        <option value="">Todos</option>
                        <option value="TI" <%= filtros.categoria === 'TI' ? 'selected' : '' %>>TI</option>
                        <option value="RH" <%= filtros.categoria === 'RH' ? 'selected' : '' %>>RH</option>
                        <option value="Financeiro" <%= filtros.categoria === 'Financeiro' ? 'selected' : '' %>>Financeiro</option>
                        <option value="Comercial" <%= filtros.categoria === 'Comercial' ? 'selected' : '' %>>Comercial</option>
                        <option value="Marketing" <%= filtros.categoria === 'Marketing' ? 'selected' : '' %>>Marketing</option>
                        <option value="Operacoes" <%= filtros.categoria === 'Operacoes' ? 'selected' : '' %>>Operacoes</option>
                        <option value="Juridico" <%= filtros.categoria === 'Juridico' ? 'selected' : '' %>>Juridico</option>
                    </select>
                </div>
                <!-- RF05.3: Ordenacao -->
                <div class="flex gap-3">
                    <label for="ordem">Ordem</label>
                    <select id="ordem" name="ordem" class="px-2 py-1 bg-slate-200 border-2 border-solid border-slate-300 rounded">
                        <option value="desc" <%= filtros.ordem === 'desc' ? 'selected' : '' %>>Mais recentes</option>
                        <option value="asc" <%= filtros.ordem === 'asc' ? 'selected' : '' %>>Mais antigos</option>
                    </select>
                </div>
                <button type="submit" class="px-5 py-1 bg-purple-800 text-white font-bold font-display rounded mt-5">Filtrar</button>
                <a href="/home" class="px-5 py-1 bg-slate-400 text-white font-bold font-display rounded mt-5">Limpar</a>
            </form>
        </div>
    </div>
    
    <% if (solicitacoes.length === 0) { %>
        <p>Nenhuma solicitação encontrada.</p>
    <% } else { %>
        <table border="1" cellpadding="8" cellspacing="0" class="px-5 py-3 bg-slate-200 rounded mt-5">
            <thead class="text-lg rounded text-center font-semibold font-display x-3 py-2">
                <tr class="bg-purple-200 border-solid border-r-4 border-white">
                    <th>Titulo</th>
                    <th>Pergunta</th>
                    <th>Colaborador</th>
                    <th>Departamento</th>
                    <th>Destino</th>
                    <th>Status</th>
                    <th>Data</th>
                </tr>
            </thead>
            <tbody>
                <% solicitacoes.forEach(s => { %>
                    <tr>
                        <td class="font-semibold"><%= s.titulo_pergunta %></td>
                        <td class="text-slate-700"><%= s.pergunta %></td>
                        <td class="border-b-3 border-slate-800 border solid"><%= s.nome %></td>
                        <td class="border-b-3 border-slate-800 border solid"><%= s.departamento %></td>
                        <td class="border-b-3 border-slate-800 border solid"><%= s.categoria || '' %></td>
                        <td class="border-b-3 border-slate-800 border solid"><%= s.status || 'aberto' %></td>
                        <td class="border-b-3 border-slate-800 border solid"><%= s.data_criacao ? new Date(s.data_criacao).toLocaleDateString('pt-BR') : '' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

<%- include('partials/footer') %>
