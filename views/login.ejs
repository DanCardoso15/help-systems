<%- include('partials/header') %>


<div class="w-full h-screen flex justify-center items-center">
    <div class="w-3/4 flex flex-col place-content-center">
        <h2 class="text-center text-3xl font-bold">Login</h2>
        <div class="w-150 mx-auto my-6">
            <% if (erro) { %>
                <p class="bg-red-100 pl-1 rounded border-solid border-l-4 border-red-500 font-semibold text-lg mb-3"><%= erro %></p>
            <% } %>
            <form method="POST" action="/login" class="flex flex-col gap-4 text-2xl">
                <div class="flex gap-3">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email" required placeholder="seu@email.com" class="px-1 bg-slate-50 rounded border">
                </div>
                <div class="flex gap-3">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" required class="px-1 bg-slate-50 rounded border">
                </div>
                <button type="submit" class="w-full py-3 bg-purple-800 text-white font-bold font-display rounded mt-5">Entrar</button>
            </form>
            
            <p class="text-center">Não tem conta? <a href="/cadastro" class="text-purple-800 hover:text-purple-950">Cadastre-se</a></p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
