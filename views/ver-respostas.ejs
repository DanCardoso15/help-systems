<%- include('partials/header') %>

<div class="w-full h-screen flex flex-col justify-center items-center gap-5">
    <h1 class="font-display text-3xl">Respostas</h1>
    <div class="w-3/5 flex flex-col justify-center items-center bg-slate-100 px-10 py-5 gap-5">

        <% if (respostas.length === 0) { %>
            <p class="bg-red-100 pl-1 rounded border-solid border-l-4 border-red-500 font-semibold text-lg mb-3">Nenhuma resposta encontrada.</p>
        <% } else { %>

            <table border="1" cellpadding="8" cellspacing="0" class="w-4/5 px-5 py-3 bg-slate-200 rounded mt-5">
                <thead class="text-lg rounded text-center font-semibold font-display">
                    <tr class="bg-slate-300 border-solid border-b-4 border-purple-800">
                        <th>Título</th>
                        <th>Pergunta</th>
                        <th>Solicitante</th>
                        <th>Destino</th>
                        <th>Resposta</th>
                        <th>Respondido por</th>
                    </tr>
                </thead>
                <tbody>
                    <% respostas.forEach(r => { %>
                        <tr>
                            <td class="font-semibold"><%= r.titulo_pergunta %></td>
                            <td class="text-slate-700"><%= r.pergunta %></td>
                            <td><%= r.solicitante || '' %></td>
                            <td class="text-center"><%= r.categoria || '' %></td>
                            <td class="text-slate-700"><%= r.resposta %></td>
                            <td><%= r.respondido_por || '' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
        <a href="/home" class="self-center px-10 py-4 bg-slate-700 text-white rounded">Voltar</a>
    </div>
</div>

<%- include('partials/footer') %>
