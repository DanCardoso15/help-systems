<%- include('partials/header') %>

<div class="w-full h-screen flex flex-col justify-center items-center">
    <h1 class="font-display text-3xl">Registrar Pergunta</h1>
    <div class="w-3/5 flex flex-col justify-center bg-slate-100">
    
        <% if (erro) { %>
            <p class="bg-red-100 pl-1 rounded border-solid border-l-4 border-red-500 font-semibold text-lg mb-3"><%= erro %></p>
        <% } %>
        <% if (sucesso) { %>
            <p class="bg-green-100 pl-1 rounded border-solid border-l-4 border-green-500 font-semibold text-lg mb-3"><%= sucesso %></p>
        <% } %>
    
        <div class="flex flex-col gap-8 text-lg items-center">
            <form method="POST" action="/solicitacoes/nova" class="w-full flex flex-col gap-4">
                <div>
                    <label for="categoria">Departamento Destino</label>
                    <select id="categoria" name="categoria" required class="px-2 py-1 bg-slate-200 border-2 border-solid border-slate-300 rounded">
                        <option value="">Selecione o departamento</option>
                        <option value="TI">TI</option>
                        <option value="RH">RH</option>
                        <option value="Financeiro">Financeiro</option>
                        <option value="Comercial">Comercial</option>
                        <option value="Marketing">Marketing</option>
                        <option value="Operacoes">Operacoes</option>
                        <option value="Juridico">Juridico</option>
                    </select>
                </div>
                <div class="flex flex-col gap-4 justify-between">
                    <label for="titulo_pergunta">Titulo da Pergunta</label>
                    <input type="text" id="titulo_pergunta" name="titulo_pergunta" required class="px-1 rounded border-2 border-solid border-slate-300">
                </div>
                <div class="flex flex-col gap-4 justify-between">
                    <label for="pergunta">Pergunta</label>
                    <textarea id="pergunta" name="pergunta" required class="px-1 bg-slate-100 rounded border-2 border-solid border-slate-300 w-3/4 h-3/5"></textarea>
                </div>
                <button type="submit" class="w-full py-3 bg-emerald-500 text-white font-bold font-display rounded mt-5">Enviar</button>
            </form>
        </div>
    
        <a href="/home" class="px-6 py-3 bg-slate-800 text-white font-bold text-xl rounded mt-5">Voltar</a>
    </div>
</div>

<%- include('partials/footer') %>
